generator client {
  provider = "prisma-client"
  output   = "../lib/db-prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String  @id @default(cuid())
  isService Boolean @default(false)

  // Self-relation: a login account (isService: false) owns N service
  // accounts (isService: true — today's "contacts")
  ownerId  String?
  owner    Account?  @relation("AccountOwnership", fields: [ownerId], references: [id], onDelete: Cascade)
  contacts Account[] @relation("AccountOwnership")

  // --- Login-only fields (Google OAuth identity) — null for service accounts ---
  googleId     String?   @unique
  email        String?   @unique
  picture      String?
  accessToken  String?
  refreshToken String?
  expiryDate   DateTime?
  scope        String?
  syncToken    String?

  // --- Shared / contact-ish fields ---
  name        String
  description String?
  business    String?
  category    String?
  phone       String?
  initials    String?
  color       String?
  note        String?
  online      Boolean  @default(false)

  // When this row was created as a contact mirror of another Account,
  // this stores the source account's id for deduplication checks.
  linkedAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls         Call[]
  knowledge     ContactKnowledge[]
  conversations Conversation[]
  queries       Query[]
  tasks         Task[]

  @@index([ownerId])
}

model Conversation {
  id                     String    @id @default(cuid())
  title                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  lastExtractedMessageId String?
  lastExtractedAt        DateTime?
  status                 String    @default("active")
  endedAt                DateTime?
  topicSummary           String?
  contactId              String
  calls                  Call[]
  contact                Account   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  history                History[]
  messages               Message[]
  queries                Query[]
  tasks                  Task[]

  @@index([contactId])
  @@index([contactId, status])
}

model Message {
  id               String                   @id @default(cuid())
  role             String
  content          String
  time             String
  pending          Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  conversationId   String
  callId           String?
  knowledgeSources KnowledgeSourceMessage[]
  call             Call?                    @relation(fields: [callId], references: [id])
  conversation     Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  querySources     QuerySourceMessage[]
  taskSources      TaskSourceMessage[]
}

model History {
  id             String       @id @default(cuid())
  title          String
  detail         String
  status         String
  time           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Task {
  id              String              @id @default(cuid())
  title           String
  description     String?
  status          String              @default("suggested")
  priority        String              @default("normal")
  dueDate         DateTime?
  confidence      Float               @default(1.0)
  source          String              @default("agent")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?
  conversationId  String
  contactId       String
  googleEtag      String?
  googleEventId   String?
  lastSyncedAt    DateTime?
  callTriggeredAt DateTime?
  contact         Account             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation    Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources         TaskSourceMessage[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
  @@index([googleEventId])
}

model TaskSourceMessage {
  id        String  @id @default(cuid())
  taskId    String
  messageId String
  role      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, messageId, role])
}

model Query {
  id                String               @id @default(cuid())
  question          String
  answer            String?
  status            String               @default("pending")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  answeredAt        DateTime?
  answerMessageId   String?
  isKnowledgeGap    Boolean              @default(false)
  knowledgeKey      String?
  knowledgeCategory String?
  conversationId    String
  contactId         String
  contact           Account              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources           QuerySourceMessage[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
  @@index([isKnowledgeGap])
}

model QuerySourceMessage {
  id        String  @id @default(cuid())
  queryId   String
  messageId String
  role      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  query     Query   @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([queryId, messageId, role])
}

model Call {
  id                String       @id @default(cuid())
  status            String       @default("initiated")
  direction         String       @default("outbound")
  from              String
  to                String
  recordingUrl      String?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSec       Int?
  disconnectedBy    String?
  isEnoughKnowledge Boolean?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  conversationId    String
  contactId         String
  contact           Account      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
}

model ContactKnowledge {
  id         String                   @id @default(cuid())
  contactId  String
  category   String
  key        String
  value      String
  confidence Float                    @default(1.0)
  status     String                   @default("active")
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  contact    Account                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sources    KnowledgeSourceMessage[]

  @@unique([contactId, key])
  @@index([contactId, status])
}

model KnowledgeSourceMessage {
  id          String           @id @default(cuid())
  knowledgeId String
  messageId   String
  role        String
  message     Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledge   ContactKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@unique([knowledgeId, messageId, role])
}
