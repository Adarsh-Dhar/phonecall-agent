// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/db-prisma/generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  business  String
  category  String   // e.g. "Healthcare", "Personal Care", "Home & Auto", "Financial & Insurance", "Government", "Retail & Customer Service", "Other"
  phone     String   // E.164 phone number for the contact, e.g. +14155551234
  initials  String
  color     String
  note      String?
  online    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  tasks         Task[]
  queries       Query[]
  knowledge     ContactKnowledge[]
  calls         Call[]
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  history   History[]
  tasks     Task[]

  // Extraction cursor — tracks the last message already processed by the
  // task-mining pipeline so each run only sees the delta.
  lastExtractedMessageId String?
  lastExtractedAt        DateTime?

  // Conversation lifecycle fields
  status       String    @default("active") // "active" | "ended"
  endedAt      DateTime?
  topicSummary String?

  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  queries   Query[]
  calls     Call[]

  @@index([contactId])
  @@index([contactId, status])
}

model Message {
  id             String       @id @default(cuid())
  role           String       // "user" | "assistant"
  content        String
  time           String
  pending        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Optional link to the call this transcript turn came from
  callId         String?
  call           Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)

  taskSources    TaskSourceMessage[]
  querySources   QuerySourceMessage[]
  knowledgeSources KnowledgeSourceMessage[]
}

model History {
  id             String       @id @default(cuid())
  title          String
  detail         String
  status         String       // "Completed" | "Needs you" | "In Progress"
  time           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("suggested")
  // suggested -> open -> in_progress -> done | cancelled
  priority    String    @default("normal")   // low | normal | high
  dueDate     DateTime?
  confidence  Float     @default(1.0)        // model certainty 0-1
  source      String    @default("agent")    // "agent" | "user"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sources   TaskSourceMessage[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
}

// Join table: which message(s) a task was mined from / updated by.
model TaskSourceMessage {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  role      String  // "created" | "updated" | "completed" — why this message is linked

  @@unique([taskId, messageId, role])
}

// ---------------------------------------------------------------------------
// Query — an unanswered question surfaced from the conversation that needs
// the user's input before the agent can proceed.
// ---------------------------------------------------------------------------
model Query {
  id        String    @id @default(cuid())
  question  String
  answer    String?
  status    String    @default("pending")
  // pending -> answered | dismissed
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  answeredAt DateTime?

  // The message that was synthetically created when the user answered,
  // so it appears in the conversation transcript.
  answerMessageId String?

  // Knowledge gap tracking — marks queries created due to insufficient knowledge
  // and stores the key/category for upserting into ContactKnowledge when answered.
  isKnowledgeGap    Boolean  @default(false)
  knowledgeKey      String?
  knowledgeCategory String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  sources   QuerySourceMessage[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
  @@index([isKnowledgeGap])
}

// Join table: which message(s) a query was mined from / dismissed by.
model QuerySourceMessage {
  id        String  @id @default(cuid())
  queryId   String
  query     Query   @relation(fields: [queryId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  role      String  // "asked" | "dismissed"

  @@unique([queryId, messageId, role])
}

// ---------------------------------------------------------------------------
// Call — tracks each phone call placed/received via Exotel's Voicebot Applet.
// ---------------------------------------------------------------------------
model Call {
  id                String    @id @default(cuid())
  exotelCallSid     String?   @unique   // Exotel's Call Sid, set once Exotel responds/streams
  streamSid         String?             // Voicebot Applet stream id, set on the "start" WS event
  status            String    @default("initiated")
  // initiated | ringing | in-progress | completed | failed | no-answer | busy
  direction         String    @default("outbound")  // outbound | inbound
  from              String
  to                String
  recordingUrl      String?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSec       Int?
  disconnectedBy    String?   // "user" | "bot" | null
  isEnoughKnowledge  Boolean? // set after post-call analysis; mirrors old Email field's meaning
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  contactId  String
  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  messages   Message[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ContactKnowledge — durable facts about a contact, persisted across
// conversation threads so the agent has memory beyond one chat.
// ---------------------------------------------------------------------------
model ContactKnowledge {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  category    String   // "preference" | "fact" | "history" | "constraint" | "contact_info"
  key         String   // stable snake_case label, e.g. "preferred_contact_time"
  value       String   // the fact itself, one sentence
  confidence  Float    @default(1.0)
  status      String   @default("active") // active | superseded | stale

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sources     KnowledgeSourceMessage[]

  @@unique([contactId, key])
  @@index([contactId, status])
}

model KnowledgeSourceMessage {
  id          String           @id @default(cuid())
  knowledgeId String
  knowledge   ContactKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  messageId   String
  message     Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  role        String           // "created" | "updated"

  @@unique([knowledgeId, messageId, role])
}
