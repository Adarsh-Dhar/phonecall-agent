generator client {
  provider = "prisma-client"
  output   = "../lib/db-prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                        String             @id(map: "User_pkey") @default(cuid())
  googleId                  String?            @unique
  email                     String?            @unique
  name                      String?
  picture                   String?
  accessToken               String?
  refreshToken              String?
  expiryDate                DateTime?
  scope                     String?
  syncToken                 String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  isService                 Boolean            @default(false)
  ownerId                   String?
  business                  String?
  category                  String?
  phone                     String?
  initials                  String?
  color                     String?
  note                      String?
  online                    Boolean            @default(false)
  linkedAccountId           String?
  description               String?
  lastSeenAt                DateTime?
  timezone                  String?
  quietHoursStart           Int?
  quietHoursEnd             Int?
  businessHoursJson         String?
  agentAutoAnswer           Boolean            @default(false)
  owner                     Account?           @relation("AccountOwnership", fields: [ownerId], references: [id], onDelete: Cascade)
  contacts                  Account[]          @relation("AccountOwnership")
  closures                  BusinessClosure[]
  calls                     Call[]
  knowledge                 ContactKnowledge[]
  conversations             Conversation[]
  ownerInfo                 OwnerInfo[]
  pushSubscriptions         PushSubscription[]
  queries                   Query[]
  relationshipsAsBusiness   Relationship[]     @relation("RelBusiness")
  relationshipsAsIndividual Relationship[]     @relation("RelIndividual")
  tasks                     Task[]

  @@index([ownerId])
}

model Conversation {
  id                      String    @id @default(cuid())
  title                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastExtractedMessageId  String?
  lastExtractedAt         DateTime?
  status                  String    @default("active")
  endedAt                 DateTime?
  topicSummary            String?
  contactId               String
  extractionFailureCount  Int       @default(0)
  extractionFailureCursor String?
  calls                   Call[]
  contact                 Account   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  history                 History[]
  messages                Message[]
  queries                 Query[]
  tasks                   Task[]

  @@index([contactId])
  @@index([contactId, status])
}

model Relationship {
  id             String     @id @default(cuid())
  individualId   String
  businessId     String
  contactId      String
  summary        String     @default("")
  summaryUpTo    DateTime?
  summaryVersion Int        @default(0)
  lastCallId     String?
  lastCallAt     DateTime?
  consolidating  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  openLoops      OpenLoop[]
  business       Account    @relation("RelBusiness", fields: [businessId], references: [id], onDelete: Cascade)
  individual     Account    @relation("RelIndividual", fields: [individualId], references: [id], onDelete: Cascade)

  @@unique([individualId, businessId])
}

model CallSummary {
  callId         String   @id
  relationshipId String
  outcome        String
  summary        String
  agreements     Json     @default("[]")
  proposals      Json     @default("[]")
  promises       Json     @default("[]")
  businessTerms  Json     @default("{}")
  createdAt      DateTime @default(now())
  model          String
  promptVersion  Int

  @@index([relationshipId])
}

model OpenLoop {
  id             String       @id @default(cuid())
  relationshipId String
  kind           String
  text           String
  status         String       @default("open")
  dueAt          DateTime?
  sourceCallId   String?
  taskId         String?
  queryId        String?
  visibility     String       @default("individual_only")
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId, status])
}

model Message {
  id               String                   @id @default(cuid())
  role             String
  content          String
  time             String
  pending          Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  conversationId   String
  callId           String?
  relationshipId   String?
  seq              BigInt?
  speaker          String?
  visibility       String                   @default("both")
  knowledgeSources KnowledgeSourceMessage[]
  call             Call?                    @relation(fields: [callId], references: [id])
  conversation     Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  querySources     QuerySourceMessage[]
  taskSources      TaskSourceMessage[]

  @@unique([relationshipId, seq])
  @@index([relationshipId, seq])
}

model History {
  id             String       @id @default(cuid())
  title          String
  detail         String
  status         String
  time           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Task {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  status             String              @default("suggested")
  priority           String              @default("normal")
  dueDate            DateTime?
  confidence         Float               @default(1.0)
  source             String              @default("agent")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  completedAt        DateTime?
  conversationId     String
  contactId          String
  googleEtag         String?
  googleEventId      String?
  lastSyncedAt       DateTime?
  callTriggeredAt    DateTime?
  parentTaskId       String?
  kind               String              @default("call")
  callAttempts       Int                 @default(0)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?
  schedulerClaimedAt DateTime?
  schedulerStatus    String              @default("pending")
  calls              Call[]
  contact            Account             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources            TaskSourceMessage[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
  @@index([googleEventId])
  @@index([schedulerStatus, nextAttemptAt])
}

model TaskSourceMessage {
  id        String  @id @default(cuid())
  taskId    String
  messageId String
  role      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, messageId, role])
}

model Query {
  id                String               @id @default(cuid())
  question          String
  answer            String?
  status            String               @default("pending")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  answeredAt        DateTime?
  answerMessageId   String?
  isKnowledgeGap    Boolean              @default(false)
  knowledgeKey      String?
  knowledgeCategory String?
  conversationId    String
  contactId         String
  callId            String?
  urgent            Boolean              @default(false)
  contact           Account              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources           QuerySourceMessage[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
  @@index([isKnowledgeGap])
  @@index([callId])
}

model QuerySourceMessage {
  id        String  @id @default(cuid())
  queryId   String
  messageId String
  role      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  query     Query   @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([queryId, messageId, role])
}

model Call {
  id                String       @id @default(cuid())
  status            String       @default("initiated")
  direction         String       @default("outbound")
  from              String
  to                String
  recordingUrl      String?
  startedAt         DateTime?
  endedAt           DateTime?
  durationSec       Int?
  disconnectedBy    String?
  isEnoughKnowledge Boolean?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  conversationId    String
  contactId         String
  calleeAccountId   String?
  ringingAt         DateTime?
  acceptedAt        DateTime?
  confirmationRef   String?
  confirmedAt       DateTime?
  outcome           String?
  outcomeSummary    String?
  taskId            String?
  individualId      String?
  businessId        String?
  initiatedBy       String?
  briefingSnapshot  Json?
  briefingVersion   Int?
  consolidatedAt    DateTime?
  contact           Account      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task              Task?        @relation(fields: [taskId], references: [id])
  messages          Message[]

  @@index([conversationId])
  @@index([contactId])
  @@index([status])
  @@index([calleeAccountId])
  @@index([taskId])
  @@index([individualId])
  @@index([businessId])
}

model ContactKnowledge {
  id         String                   @id @default(cuid())
  contactId  String
  category   String
  key        String
  value      String
  confidence Float                    @default(1.0)
  status     String                   @default("active")
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  contact    Account                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sources    KnowledgeSourceMessage[]

  @@unique([contactId, key])
  @@index([contactId, status])
}

model KnowledgeSourceMessage {
  id          String           @id @default(cuid())
  knowledgeId String
  messageId   String
  role        String
  knowledge   ContactKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  message     Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([knowledgeId, messageId, role])
}

model PushSubscription {
  id        String   @id @default(cuid())
  accountId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model OwnerInfo {
  id        String   @id @default(cuid())
  ownerId   String
  category  String
  key       String
  value     String
  shareable Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Account  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, key])
  @@index([ownerId])
}

model BusinessClosure {
  id         String    @id @default(cuid())
  businessId String
  kind       String
  label      String?
  message    String?
  startsAt   DateTime
  endsAt     DateTime?
  allDay     Boolean   @default(false)
  blockCalls Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Account   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
  @@index([businessId, endsAt])
}
