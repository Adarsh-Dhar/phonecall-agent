
# Database Configuration
DATABASE_URL=file:./prisma/dev.db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model — confirm the exact model ID your API key can access
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Server Configuration
PORT=5175
BASE_PATH=/

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# ── Seed / Testing ────────────────────────────────────────────────────────────
# Real E.164 phone number to use when seeding contacts for call testing
# e.g. TEST_PHONE_NUMBER=+14155551234
TEST_PHONE_NUMBER=+10000000000

# Real E.164 phone numbers YOU control, for testing the agent placing calls
# to multiple "service providers" at once — same idea as the old
# TEST_PROVIDER_EMAILS pool, but for phone numbers. Leave unset to keep
# seed.ts's existing single-number test setup.
#   TEST_PROVIDER_PHONES=+14155550001,+14155550002
TEST_PROVIDER_PHONES=

# ── Google Calendar Integration ────────────────────────────────────────────────
# Google Cloud OAuth 2.0 client credentials for Calendar API integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5175/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary
