
# Database Configuration
DATABASE_URL=postgresql://phoneagent:phoneagent_password@localhost:5434/phone_agent

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model — confirm the exact model ID your API key can access
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Server Configuration
PORT=5175
BASE_PATH=/

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# ── Twilio ────────────────────────────────────────────────────────────────────
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_EMAIL_ADDRESS=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@twilio.email

# Public base URL reachable by Twilio (scheme + host, no trailing slash).
# For local dev use ngrok: ngrok http 5175  →  copy the https://…ngrok.app URL here.
# Twilio request-signature validation will reject webhooks if this doesn't exactly
# match the URL Twilio called (including scheme and port if non-standard).
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok.app

# Set to "true" to skip Twilio signature validation (local dev only — never in prod)
SKIP_TWILIO_SIGNATURE_CHECK=false

# ── Inbound Email ─────────────────────────────────────────────────────────────
# Twilio's Inbound Parse webhook is NOT signed with X-Twilio-Signature
# (it's a different product surface than voice/SMS), so we verify inbound email
# webhooks with a shared-secret query param instead. Generate a long random
# value and put the SAME value in the Inbound Parse "Destination URL" you
# configure in the console, e.g.:
#   https://your-domain/api/emails/inbound?token=<this value>
EMAIL_INBOUND_SECRET=change_me_to_a_long_random_value

# The domain/hostname your Inbound Parse MX records point at (see Twilio
# console → Settings → Inbound Parse). Used only for reference/logging here.
EMAIL_INBOUND_DOMAIN=inbound.your-domain.com

# ── Seed / Testing ────────────────────────────────────────────────────────────
# Real E.164 phone number to use when seeding contacts for call testing
# e.g. TEST_PHONE_NUMBER=+14155551234
TEST_PHONE_NUMBER=+10000000000

# Comma-separated pool of real inboxes YOU control, for testing the agent
# talking to multiple "service providers" over email at once. Each address
# is assigned to a different contact at seed time (so you can reply from
# that real inbox pretending to be that provider); every other contact
# gets email: null. Leave unset to use the built-in default pool in
# seed.ts. The first 11 non-Assistant contacts get the emails.
#   TEST_PROVIDER_EMAILS=a@gmail.com,b@gmail.com,c@gmail.com
TEST_PROVIDER_EMAILS=
