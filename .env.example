
# Database Configuration
DATABASE_URL=postgresql://phoneagent:phoneagent_password@localhost:5434/phone_agent

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model — confirm the exact model ID your API key can access
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Server Configuration
PORT=5175
BASE_PATH=/

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# ── Exotel ────────────────────────────────────────────────────────────────────
# Get these from your Exotel dashboard (Settings → API Settings)
EXOTEL_SID=yourcompany
EXOTEL_API_KEY=xxxxx
EXOTEL_API_TOKEN=xxxxx
EXOTEL_SUBDOMAIN=api.exotel.com
# Your Exophone (or the trial sandbox number)
EXOTEL_CALLER_ID=0XXXXXXXXX
# App Bazaar flow id: Voicebot Applet (pointed at PUBLIC_WS_URL below) →
# Passthru Applet (pointed at .../api/calls/passthru?token=<EXOTEL_PASSTHRU_SECRET>)
EXOTEL_APP_ID=926

# Public WebSocket URL the Exotel Voicebot Applet connects to.
# For local dev use ngrok: ngrok http 5175  →  wss://<subdomain>.ngrok.app/media
PUBLIC_WS_URL=wss://your-ngrok-subdomain.ngrok.app/media

# Shared secret verifying the Passthru Applet webhook (Exotel doesn't sign
# requests, same as Twilio's old Inbound Parse) — generate a long random value
# and put it in both places:
#   EXOTEL_PASSTHRU_SECRET=<this value>
#   Passthru Applet URL: https://your-domain/api/calls/passthru?token=<this value>
EXOTEL_PASSTHRU_SECRET=change_me_to_a_long_random_value

# ── Seed / Testing ────────────────────────────────────────────────────────────
# Real E.164 phone number to use when seeding contacts for call testing
# e.g. TEST_PHONE_NUMBER=+14155551234
TEST_PHONE_NUMBER=+10000000000

# Real E.164 phone numbers YOU control, for testing the agent placing calls
# to multiple "service providers" at once — same idea as the old
# TEST_PROVIDER_EMAILS pool, but for phone numbers. Leave unset to keep
# seed.ts's existing single-number test setup.
#   TEST_PROVIDER_PHONES=+14155550001,+14155550002
TEST_PROVIDER_PHONES=
