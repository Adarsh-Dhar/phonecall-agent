
# Database Configuration
DATABASE_URL=file:./prisma/dev.db

# ── Phone Agent (live call, Gemini) ─────────────────────────────────────────────
# The live, real-time voice call itself (services/geminiVoiceSession.ts and
# friends) stays on Gemini Live — this is a low-latency voice API that the
# orchestrator's text provider does not need to match.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model — confirm the exact model ID your API key can access
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# ── Orchestrator (text reasoning, Nebius Token Factory) ─────────────────────────
# All non-voice reasoning — task/knowledge extraction, escalation decisions,
# conversation topic classification/summaries, and the demo chat route — runs
# against Nebius Token Factory's OpenAI-compatible API on an NVIDIA open model.
# See services/nebiusText.ts and services/taskExtraction/orchestratorPrompt.ts.
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/llama-3_1-nemotron-ultra-253b-v1

# Server Configuration
PORT=5175
BASE_PATH=/

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# ── Google Calendar Integration ────────────────────────────────────────────────
# Google Cloud OAuth 2.0 client credentials for Calendar API integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5175/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# ── Call Scheduler ──────────────────────────────────────────────────────────────
# How often (ms) the call-scheduler agent checks for tasks whose due date has
# arrived. See artifacts/api-server/src/services/callScheduler.ts.
CALL_SCHEDULER_POLL_MS=30000
