
# Database Configuration
DATABASE_URL=file:./prisma/dev.db

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model — confirm the exact model ID your API key can access
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# Server Configuration
PORT=5175
BASE_PATH=/

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# ── Google Calendar Integration ────────────────────────────────────────────────
# Google Cloud OAuth 2.0 client credentials for Calendar API integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5175/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# ── Call Scheduler ──────────────────────────────────────────────────────────────
# How often (ms) the call-scheduler agent checks for tasks whose due date has
# arrived. See artifacts/api-server/src/services/callScheduler.ts.
CALL_SCHEDULER_POLL_MS=30000
