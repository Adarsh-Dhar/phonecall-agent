# Stress Kit Configuration
# Copy this to .env and fill in the values

# API Configuration
API_BASE=http://localhost:5175/api
WS_BASE=ws://localhost:5175
JWT_SECRET=your-super-secret-jwt-key-change-in-production
HEARTBEAT_MS=1000

# Test Configuration
N_INDIVIDUALS=20
CONCURRENCY=20
ITERATIONS=200

# Database (must match docker-compose.yml postgres-test service)
# Uses port 5435 to avoid conflict with default PostgreSQL on 5432
TEST_DATABASE_URL=postgresql://phoneagent:phoneagent_password@localhost:5435/phone_agent_test
