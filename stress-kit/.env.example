# Stress Kit Configuration
# Copy this to .env and fill in the values
# REQUIRED variables are marked with [REQUIRED]
# Optional variables have defaults shown

# ==========================================
# REQUIRED: API Configuration
# ==========================================
API_BASE=http://localhost:5175/api
WS_BASE=ws://localhost:5175
JWT_SECRET=your-super-secret-jwt-key-change-in-production
HEARTBEAT_MS=1000

# ==========================================
# REQUIRED: Database Configuration
# ==========================================
# Uses port 5435 to avoid conflict with default PostgreSQL on 5432
# Database name MUST end with _test (safety requirement)
TEST_DATABASE_URL=postgresql://phoneagent:phoneagent_password@localhost:5435/phone_agent_test

# ==========================================
# REQUIRED: Gemini Configuration
# ==========================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# ==========================================
# REQUIRED: Nebius Configuration
# ==========================================
# Get your API key from your Nebius account
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.nebius.ai/v1
NEBIUS_MODEL=nebius/model-name

# ==========================================
# OPTIONAL: Nebius Configuration
# ==========================================
# Fallback model to use if NEBIUS_MODEL returns 404
NEBIUS_FALLBACK_MODEL=nebius/fallback-model-name
# Maximum number of Nebius API calls per test run (default: 1000)
NEBIUS_RUN_BUDGET=1000
# Nebius request timeout in milliseconds (default: 90000)
NEBIUS_TIMEOUT_MS=90000

# ==========================================
# OPTIONAL: Test Configuration
# ==========================================
N_INDIVIDUALS=20
CONCURRENCY=20
ITERATIONS=200

# ==========================================
# OPTIONAL: Test Overrides
# ==========================================
# Override the max call duration cap for P7 scenario (in minutes)
P7_CAP_MINUTES=1
